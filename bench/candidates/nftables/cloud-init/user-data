#cloud-config
# nftables SUT cloud-init for thurward bench harness.
#
# Two NICs (libvirt assigns ens3 = lan-thurward, ens4 = wan-thurward).
# Static IPs; no DHCP on either bridge (see topology/lan-thurward.xml).
# IP forwarding on; nftables ruleset baked in via runcmd before the
# default-deny policy locks the SUT down.

hostname: thur-nftables
manage_etc_hosts: true

users:
  - name: bench
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      # @@HARNESS_SSH_KEY@@ — substituted by bench/scripts/render-cloud-init.sh
      - "@@HARNESS_SSH_KEY@@"

write_files:
  - path: /etc/sysctl.d/99-thurward-forward.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.ipv4.conf.all.rp_filter = 0
      net.ipv6.conf.all.disable_ipv6 = 1

  - path: /etc/netplan/60-thurward.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          ens3:
            dhcp4: false
            addresses: [10.10.0.1/24]
            optional: true
          ens4:
            dhcp4: false
            addresses: [203.0.113.1/24]
            optional: true

  - path: /etc/nftables.conf
    permissions: "0644"
    content: |
      # @@RULES_NFT@@ — substituted by bench/scripts/render-cloud-init.sh
      @@RULES_NFT@@

  - path: /etc/systemd/system/nftables-thurward.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Load thurward-equivalent nftables ruleset
      After=network-pre.target
      Before=network.target
      Wants=network-pre.target

      [Service]
      Type=oneshot
      ExecStart=/usr/sbin/nft -f /etc/nftables.conf
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

packages:
  - nftables
  - tcpdump
  - iperf3
  - conntrack

runcmd:
  - sysctl --system
  - netplan apply || true
  - systemctl enable --now nftables-thurward.service
  - nft list ruleset > /var/log/thurward-ruleset.log
