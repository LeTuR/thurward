<!--
WAN-side bridge for the bench harness. Hosts the "server" side of the
firewall under test. Address space uses the TEST-NET-3 reserved
prefix 203.0.113.0/24 to avoid collision with any real network and to
match the DNAT examples in examples/rules.yaml.

No external NAT, no DHCP — every guest has a static IP via cloud-init.
-->
<network>
  <name>wan-thurward</name>
  <forward mode='none'/>
  <bridge name='thur-wan0' stp='off' delay='0'/>
  <!-- Host-side bridge IP. The SUT owns 203.0.113.1 (gateway from the
       WAN-side endpoint's point of view); the host parks at
       203.0.113.254 so it can reach the wan-netns endpoint inside the
       generator VM without colliding with the SUT's WAN address. -->
  <ip address='203.0.113.254' netmask='255.255.255.0'>
    <!-- No <dhcp> block — see lan-thurward.xml for rationale. -->
  </ip>
</network>
